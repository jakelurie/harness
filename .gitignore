node_modules/
.DS_Store
*.log

# Nothing here holds secrets today — real config and keys live in the OS
# application-support directory, not the repo — but these are the shapes that
# would carry them if the layout ever changed.
secrets.json
server-token
models.json
.env

# TLS material fetched from Tailscale for local HTTPS. These are private keys
# for this machine's own hostname and must never be committed.
*.key
*.crt
*.pem

# Python bytecode from the earlier CLI prototype.
__pycache__/
*.pyc
